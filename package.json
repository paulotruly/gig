{
  "name": "gig",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/db",
    "apps/api",
    "apps/worker"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @gig/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "migrate": "npm run migrate --workspace @gig/db",
    "dev:worker": "npm run dev --workspace @gig/worker"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1"
  }
}
