# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://gig:troque-esta-senha@127.0.0.1:3306/gig
# Em produção, usuário somente leitura de partner_metrics.
# DATABASE_URL_PARTNER_METRICS=mysql://gig_metricas:troque-esta-senha@127.0.0.1:3306/gig
FRONTEND_ORIGIN=http://localhost:3001
APP_BASE_URL=http://localhost:3001
TRUST_PROXY_HOPS=0
# Só para o webhook do WhatsApp; sem o segredo, ele fica indisponível.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Chave de 32 bytes em base64 para os tokens do Open Finance.
# TOKEN_ENCRYPTION_KEY=
# Só para os testes de integração; o nome do banco precisa terminar em _test.
DATABASE_URL_TEST=mysql://root:troque-esta-senha@127.0.0.1:3306/gig_test
