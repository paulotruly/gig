# Copie para .env e ajuste. Nunca versione o .env.
# As variáveis seguem apps/api/src/config.ts; as comentadas são opcionais.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=mysql://gig:troque-esta-senha@127.0.0.1:3306/gig
# Em produção é obrigatória: usuário somente leitura de partner_metrics.
# DATABASE_URL_PARTNER_METRICS=mysql://gig_metricas:troque-esta-senha@127.0.0.1:3306/gig

FRONTEND_ORIGIN=http://localhost:3001
APP_BASE_URL=http://localhost:3001
TRUST_PROXY_HOPS=0

# Limites de requisições.
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_PER_USER_PER_MINUTE=300
# LOGIN_LIMIT_PER_15_MINUTES=10

# Só para o webhook do WhatsApp; sem o segredo, ele fica indisponível.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# Só para os testes de integração; o nome do banco precisa terminar em _test.
DATABASE_URL_TEST=mysql://root:troque-esta-senha@127.0.0.1:3306/gig_test?allowPublicKeyRetrieval=true
